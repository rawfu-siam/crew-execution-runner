# ==========================================
# CREW-EXECUTION-RUNNER ENVIRONMENT CONFIG
# ==========================================

# OpenAI API Configuration
OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# Slack Operations Hub Webhook
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T00/B00/XXXXXXXXXXXXXXXXX

# n8n Outbound CRM Dispatcher Webhook
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/lead-ingestion

# Database Connection URI (SQLite local or PostgreSQL remote)
DATABASE_URL=sqlite:///./crew_runner.db

# Application Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
